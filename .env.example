# Copie para .env.local e ajuste
# Back da LIA (Swagger em <URL>/docs). Sem a variável, usa este mesmo endereço.
NEXT_PUBLIC_API_URL=https://backend-lia-6if6.onrender.com
NEXT_PUBLIC_VLIBRAS_URL=https://vlibras.gov.br/app
# Avatar do VLibras que dá corpo à LIA: hosana | icaro | guga
NEXT_PUBLIC_LIA_AVATAR=hosana

# Voz neural da LIA (Azure Speech). SÓ NO SERVIDOR: nunca use NEXT_PUBLIC_ aqui.
# Portal do Azure → criar recurso "Speech" (plano F0 gratuito) → "Chaves e Ponto de Extremidade".
AZURE_SPEECH_KEY=
# Região do recurso, ex.: brazilsouth, eastus
AZURE_SPEECH_REGION=brazilsouth
# Voz padrão: pt-BR-FranciscaNeural | pt-BR-ThalitaNeural | pt-BR-BrendaNeural | pt-BR-GiovannaNeural | pt-BR-LeticiaNeural | pt-BR-YaraNeural
AZURE_SPEECH_VOICE=pt-BR-FranciscaNeural
