# Copie para .env.local e ajuste
# Back da LIA (Swagger em <URL>/docs). Sem a variável, usa este mesmo endereço.
NEXT_PUBLIC_API_URL=https://backend-lia-6if6.onrender.com
# Só para o chat antigo (src/components/chat): true = respostas falsas
NEXT_PUBLIC_USE_MOCK=false
NEXT_PUBLIC_VLIBRAS_URL=https://vlibras.gov.br/app
# Avatar do VLibras que dá corpo à LIA: hosana | icaro | guga
NEXT_PUBLIC_LIA_AVATAR=hosana
